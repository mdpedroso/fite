{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://mdpedroso.github.io/fite/",
      "permanent": false
    }
  ]
}
